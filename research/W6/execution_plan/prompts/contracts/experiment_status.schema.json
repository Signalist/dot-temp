{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W6 experiment status record; PASS must state its level",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "w6-plan-1"
    },
    "experiment_id": {
      "enum": [
        "F01",
        "F02",
        "F03",
        "F04",
        "I01",
        "I02",
        "I03",
        "I04",
        "I05",
        "I06",
        "I07",
        "I08",
        "I09",
        "I10",
        "I11",
        "N01",
        "N02",
        "N03",
        "N04",
        "C01",
        "C02",
        "C03",
        "C04",
        "C05",
        "A01",
        "A02",
        "X01",
        "X02",
        "X03",
        "X04",
        "G01",
        "G02",
        "G03",
        "G04",
        "G05",
        "Z01",
        "O01",
        "O02"
      ]
    },
    "name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "priority": {
      "enum": [
        "REQUIRED",
        "CONDITIONAL",
        "OPTIONAL"
      ]
    },
    "applicability": {
      "enum": [
        "IN_SCOPE",
        "OUT_OF_SCOPE",
        "NEEDS_RESOURCES"
      ]
    },
    "tier": {
      "enum": [
        "CPU_ONLY",
        "GPU_ONLY",
        "GPU_DC",
        "PCC"
      ]
    },
    "execution_kind": {
      "enum": [
        "NOT_RUN",
        "REAL_ACQUISITION",
        "SIMULATED",
        "CPU_TEST",
        "DRY_RUN",
        "HISTORICAL_REPLAY",
        "DERIVED_REANALYSIS"
      ]
    },
    "gate_level": {
      "enum": [
        "NONE",
        "SOFTWARE",
        "STRUCTURAL_DATA",
        "PHYSICAL_ADMISSION",
        "STATISTICAL",
        "CLAIM_REVIEW",
        "PACKAGE"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "enum": [
          "F01",
          "F02",
          "F03",
          "F04",
          "I01",
          "I02",
          "I03",
          "I04",
          "I05",
          "I06",
          "I07",
          "I08",
          "I09",
          "I10",
          "I11",
          "N01",
          "N02",
          "N03",
          "N04",
          "C01",
          "C02",
          "C03",
          "C04",
          "C05",
          "A01",
          "A02",
          "X01",
          "X02",
          "X03",
          "X04",
          "G01",
          "G02",
          "G03",
          "G04",
          "G05",
          "Z01",
          "O01",
          "O02"
        ]
      }
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
      }
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "independent_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "attempts_started": {
      "type": "integer",
      "minimum": 0
    },
    "attempts_completed": {
      "type": "integer",
      "minimum": 0
    },
    "notes": {
      "type": "string"
    },
    "updated_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "name",
    "status",
    "priority",
    "applicability",
    "tier",
    "execution_kind",
    "gate_level",
    "prerequisites",
    "evidence_paths",
    "blocked_reason",
    "failure_reason",
    "independent_sessions",
    "attempts_started",
    "attempts_completed",
    "notes",
    "updated_utc"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_paths": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "BLOCKED"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        }
      },
      "then": {
        "properties": {
          "failure_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
