{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-run/attempt aggregate audit metrics; not additional independent samples",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "w6-plan-1"
    },
    "study_id": {
      "type": "string",
      "description": "稳定标识或明确类别；不可混用不同run/边界; unit=1"
    },
    "protocol_id": {
      "type": "string",
      "description": "稳定标识或明确类别；不可混用不同run/边界; unit=1"
    },
    "experiment_id": {
      "enum": [
        "F01",
        "F02",
        "F03",
        "F04",
        "I01",
        "I02",
        "I03",
        "I04",
        "I05",
        "I06",
        "I07",
        "I08",
        "I09",
        "I10",
        "I11",
        "N01",
        "N02",
        "N03",
        "N04",
        "C01",
        "C02",
        "C03",
        "C04",
        "C05",
        "A01",
        "A02",
        "X01",
        "X02",
        "X03",
        "X04",
        "G01",
        "G02",
        "G03",
        "G04",
        "G05",
        "Z01",
        "O01",
        "O02"
      ]
    },
    "run_id": {
      "type": "string",
      "description": "稳定标识或明确类别；不可混用不同run/边界; unit=1"
    },
    "attempt_id": {
      "type": "string",
      "description": "稳定标识或明确类别；不可混用不同run/边界; unit=1"
    },
    "session_id": {
      "type": "string",
      "description": "稳定标识或明确类别；不可混用不同run/边界; unit=1"
    },
    "cluster_id": {
      "type": "string",
      "description": "稳定标识或明确类别；不可混用不同run/边界; unit=1"
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "tier": {
      "enum": [
        "CPU_ONLY",
        "GPU_ONLY",
        "GPU_DC",
        "PCC"
      ]
    },
    "execution_kind": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "RUNNING",
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "requests_started": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requests_completed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requests_censored": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "requests_failed": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "analysis_requests_included": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "raw_rows": {
      "type": [
        "integer",
        "null"
      ],
      "description": "原始量与程序/系统测量方法须注明; unit=count",
      "minimum": 0
    },
    "raw_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "原始量与程序/系统测量方法须注明; unit=byte",
      "minimum": 0
    },
    "coverage_start_ns": {
      "type": [
        "integer",
        "null"
      ],
      "description": "同步误差/间隙/覆盖端点; unit=ns",
      "minimum": 0
    },
    "coverage_end_ns": {
      "type": [
        "integer",
        "null"
      ],
      "description": "同步误差/间隙/覆盖端点; unit=ns",
      "minimum": 0
    },
    "max_gap_ns": {
      "type": [
        "integer",
        "null"
      ],
      "description": "同步误差/间隙/覆盖端点; unit=ns",
      "minimum": 0
    },
    "clock_error_ns": {
      "type": [
        "integer",
        "null"
      ],
      "description": "同步误差/间隙/覆盖端点; unit=ns",
      "minimum": 0
    },
    "missing_rail_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "cap_restore_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "controller_wall_s": {
      "type": [
        "number",
        "null"
      ],
      "description": "明确事件端点及适用窗口；未知/不准入写null; unit=s"
    },
    "controller_cpu_s": {
      "type": [
        "number",
        "null"
      ],
      "description": "明确事件端点及适用窗口；未知/不准入写null; unit=s"
    },
    "solver_wall_s": {
      "type": [
        "number",
        "null"
      ],
      "description": "明确事件端点及适用窗口；未知/不准入写null; unit=s"
    },
    "solver_cpu_s": {
      "type": [
        "number",
        "null"
      ],
      "description": "明确事件端点及适用窗口；未知/不准入写null; unit=s"
    },
    "warmup_energy_J": {
      "type": [
        "number",
        "null"
      ]
    },
    "cooldown_energy_J": {
      "type": [
        "number",
        "null"
      ]
    },
    "whole_capture_energy_J": {
      "type": [
        "number",
        "null"
      ]
    },
    "peak_GPU_memory_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "原始量与程序/系统测量方法须注明; unit=byte",
      "minimum": 0
    },
    "peak_host_memory_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "description": "原始量与程序/系统测量方法须注明; unit=byte",
      "minimum": 0
    },
    "protocol_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw_manifest_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "null_reasons_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "缺失写null；可恢复的路径/主键应在同根目录解析; unit=1"
    },
    "electrical_boundary": {
      "type": "string",
      "minLength": 1,
      "description": "本行能量的命名测量边界；多边界多行不增加run/sample数量；unit=1"
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "protocol_id",
    "experiment_id",
    "run_id",
    "attempt_id",
    "session_id",
    "cluster_id",
    "stage",
    "tier",
    "execution_kind",
    "status",
    "electrical_boundary"
  ],
  "additionalProperties": false
}
