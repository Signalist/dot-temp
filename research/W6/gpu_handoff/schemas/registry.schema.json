{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "W6 registry",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "w6-1"
    },
    "evidence": {
      "enum": [
        "SIMULATED",
        "MEASURED"
      ]
    },
    "declared_before_outcomes": {
      "const": true
    },
    "transfer_axis": {
      "enum": [
        "device",
        "model_family"
      ]
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "session_id",
          "stage",
          "device_model_unit",
          "device_id_hash",
          "model_family",
          "analysis_protocol"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "evidence",
    "declared_before_outcomes",
    "transfer_axis",
    "runs"
  ],
  "additionalProperties": true,
  "description": "Structural guide; Python validator additionally checks semantics across files. Raw uncalibrated telemetry is intentionally not an admitted power-row."
}
